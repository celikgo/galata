{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "galata",
  "version-string": "0.0.1",
  "description": "Flight dynamics, control-law design and simulation: trim, linearise, synthesise, analyse, verify.",
  "license": "Apache-2.0",
  "supports": "(linux | osx | windows) & (x64 | arm64)",
  "dependencies": [
    {
      "name": "eigen3",
      "version>=": "3.4.0"
    },
    {
      "name": "fmt",
      "version>=": "10.2.1"
    },
    {
      "name": "yaml-cpp",
      "version>=": "0.8.0"
    }
  ],
  "default-features": [
    "tests"
  ],
  "features": {
    "tests": {
      "description": "Build the unit, integration, validation and determinism test suites",
      "dependencies": [
        {
          "name": "gtest",
          "version>=": "1.14.0"
        }
      ]
    }
  },
  "vcpkg-configuration": {
    "default-registry": {
      "kind": "git",
      "baseline": "56bb2411609227288b70117ead2c47585ba07713",
      "repository": "https://github.com/microsoft/vcpkg"
    }
  }
}
