#define GALATA_BUILD_CONFIGURATION_JSON "@GALATA_BUILD_CONFIGURATION_JSON@"
#define GALATA_DEPENDENCY_MANIFEST_SHA256 "@GALATA_DEPENDENCY_MANIFEST_SHA256@"
#define GALATA_EIGEN_VERSION "@GALATA_EIGEN_VERSION@"
#define GALATA_YAML_VERSION "@GALATA_YAML_VERSION@"
#endif
