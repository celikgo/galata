{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "dev",
      "displayName": "Local development (Debug)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GALATA_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "ci-linux-gcc",
      "displayName": "CI: Linux + GCC (RelWithDebInfo)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "GALATA_BUILD_TESTS": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "ci-linux-clang",
      "displayName": "CI: Linux + Clang (RelWithDebInfo)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "GALATA_BUILD_TESTS": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "ci-macos",
      "displayName": "CI: macOS arm64 + AppleClang (RelWithDebInfo)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "GALATA_BUILD_TESTS": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "ci-windows",
      "displayName": "CI: Windows x64 + MSVC (RelWithDebInfo)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "GALATA_BUILD_TESTS": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "asan",
      "displayName": "Local: AddressSanitizer + UBSan (Debug)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GALATA_ENABLE_ASAN": "ON",
        "GALATA_ENABLE_UBSAN": "ON",
        "GALATA_BUILD_TESTS": "ON"
      },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "dev",            "configurePreset": "dev",            "jobs": 0 },
    { "name": "ci-linux-gcc",   "configurePreset": "ci-linux-gcc",   "jobs": 0 },
    { "name": "ci-linux-clang", "configurePreset": "ci-linux-clang", "jobs": 0 },
    { "name": "ci-macos",       "configurePreset": "ci-macos",       "jobs": 0 },
    { "name": "ci-windows",     "configurePreset": "ci-windows",     "jobs": 0 },
    { "name": "asan",           "configurePreset": "asan",           "jobs": 0 }
  ],
  "testPresets": [
    {
      "name": "default-test",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    { "name": "dev",            "configurePreset": "dev",            "inherits": "default-test" },
    { "name": "ci-linux-gcc",   "configurePreset": "ci-linux-gcc",   "inherits": "default-test" },
    { "name": "ci-linux-clang", "configurePreset": "ci-linux-clang", "inherits": "default-test" },
    { "name": "ci-macos",       "configurePreset": "ci-macos",       "inherits": "default-test" },
    { "name": "ci-windows",     "configurePreset": "ci-windows",     "inherits": "default-test" },
    { "name": "asan",           "configurePreset": "asan",           "inherits": "default-test" }
  ]
}
